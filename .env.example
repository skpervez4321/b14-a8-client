# MongoDB connection string (Atlas). Used by BetterAuth to store users and sessions.
MONGODB_URI=
MONGODB_DB=seba_shongi_auth

# Any long random text. Make a new one for the live site.
BETTER_AUTH_SECRET=

# This website's own address, no slash at the end.
# Local: http://localhost:3000   Live: your Vercel address (https://...)
BETTER_AUTH_URL=http://localhost:3000

# GitHub login (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The server (API) address, no slash at the end.
# Local: http://localhost:5000   Live: your server's Vercel/Render address
NEXT_PUBLIC_API_URL=http://localhost:5000
